-- =====================================================
-- 21. CTE: FRAUD CONCENTRATION BY RISK TIER
-- =====================================================

WITH risk_summary AS (
    SELECT
        risk_tier,
        COUNT(*) AS total_transactions,
        SUM(fraud_flag) AS fraud_cases
    FROM upi_transactions
    GROUP BY risk_tier
)

SELECT
    risk_tier,
    total_transactions,
    fraud_cases,
    ROUND(
        fraud_cases * 100.0 /
        SUM(fraud_cases) OVER (),
        2
    ) AS pct_of_all_fraud
FROM risk_summary
ORDER BY
    CASE risk_tier
        WHEN 'Low' THEN 1
        WHEN 'Medium' THEN 2
        WHEN 'High' THEN 3
    END;
-- =====================================================
-- 22. RANK STATES BY FRAUD RATE
-- =====================================================

WITH state_summary AS (
    SELECT
        sender_state,
        COUNT(*) AS total_transactions,
        SUM(fraud_flag) AS fraud_cases,
        AVG(fraud_flag) * 100 AS fraud_rate_pct
    FROM upi_transactions
    GROUP BY sender_state
    HAVING COUNT(*) >= 10000
)

SELECT
    sender_state,
    total_transactions,
    fraud_cases,
    ROUND(fraud_rate_pct, 3) AS fraud_rate_pct,
    RANK() OVER (
        ORDER BY fraud_rate_pct DESC
    ) AS fraud_rate_rank
FROM state_summary
ORDER BY fraud_rate_rank;
-- =====================================================
-- 23. RISK SCORE RELATIVE TO OVERALL BASELINE
-- =====================================================

WITH overall AS (
    SELECT
        AVG(fraud_flag) AS overall_fraud_rate
    FROM upi_transactions
)

SELECT
    risk_score,
    COUNT(*) AS total_transactions,
    SUM(fraud_flag) AS fraud_cases,
    ROUND(AVG(fraud_flag) * 100, 3) AS fraud_rate_pct,
    ROUND(
        AVG(fraud_flag) / overall.overall_fraud_rate,
        2
    ) AS relative_risk
FROM upi_transactions
CROSS JOIN overall
GROUP BY risk_score, overall.overall_fraud_rate
ORDER BY risk_score;
-- =====================================================
-- 24. HIGH-RISK FRAUD CONCENTRATION
-- =====================================================

SELECT
    COUNT(*) AS high_risk_transactions,
    SUM(fraud_flag) AS high_risk_fraud_cases,

    ROUND(
        COUNT(*) * 100.0 /
        (SELECT COUNT(*) FROM upi_transactions),
        2
    ) AS pct_of_all_transactions,

    ROUND(
        SUM(fraud_flag) * 100.0 /
        (SELECT SUM(fraud_flag) FROM upi_transactions),
        2
    ) AS pct_of_all_fraud
FROM upi_transactions
WHERE risk_tier = 'High';
